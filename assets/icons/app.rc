#include <winres.h>
#include "app-version.h"
IDI_APP ICON "icon.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION ZSCLIP_VERSION_NUM
PRODUCTVERSION ZSCLIP_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ZSClip"
            VALUE "FileVersion", ZSCLIP_VERSION_STR
            VALUE "InternalName", "zsclip"
            VALUE "OriginalFilename", "zsclip.exe"
            VALUE "ProductName", "ZSClip"
            VALUE "ProductVersion", ZSCLIP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
